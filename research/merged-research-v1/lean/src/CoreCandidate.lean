theorem xor_cancel (a b : Bool) : (a ^^ (a ^^ b)) = b := by
  cases a <;> cases b <;> rfl

def outer_project (a : Assignment) : Assignment := fun i => match i with
  | 0 => ((a 0) ^^ false)
  | 1 => ((a 1) ^^ false)
  | 2 => ((a 2) ^^ false)
  | 3 => ((a 3) ^^ false)
  | 4 => ((a 4) ^^ false)
  | 5 => ((a 5) ^^ false)
  | 6 => ((a 6) ^^ false)
  | 7 => ((a 7) ^^ false)
  | 8 => ((a 8) ^^ ((a 12) ^^ false))
  | 9 => ((a 9) ^^ ((a 13) ^^ false))
  | 10 => ((a 10) ^^ ((a 14) ^^ false))
  | 11 => ((a 11) ^^ ((a 15) ^^ false))
  | _ => false

def outer_lift (a : Assignment) : Assignment := fun i => match i with
  | 0 => ((a 0) ^^ false)
