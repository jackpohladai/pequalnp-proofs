theorem foldLength (gs : List Gate) (w : List Bool) :
    (gs.foldl step w).length = w.length + gs.length :=
  PetersenPositivePartner.foldl_length gs w

/-- Reconstructed continuation of the prefix wire-equality induction. -/
theorem maskedAll (C : Circuit) {x y : Fin 9 → Bool} {v : Fin 9}
    (a : ∀ j, j ≠ v → x j = y j)
    (force : ∀ (pre : List Gate) (g : Gate) (post : List Gate), C.gates = pre ++ g :: post →
      v.val ∈ g.inputs →
      g.op.eval (g.inputs.map fun i => (pre.foldl step (List.ofFn x)).getD i false) =
      g.op.eval (g.inputs.map fun i => (pre.foldl step (List.ofFn y)).getD i false)) :
    ∃ s : List Bool, C.gates.foldl step (List.ofFn x) = List.ofFn x ++ s ∧
      C.gates.foldl step (List.ofFn y) = List.ofFn y ++ s := by
  have aux (todo : List Gate) : ∀ (pre : List Gate) (s : List Bool),
      C.gates = pre ++ todo →
      pre.foldl step (List.ofFn x) = List.ofFn x ++ s →
      pre.foldl step (List.ofFn y) = List.ofFn y ++ s →
      ∃ t : List Bool, C.gates.foldl step (List.ofFn x) = List.ofFn x ++ t ∧
        C.gates.foldl step (List.ofFn y) = List.ofFn y ++ t := by
    induction todo with
    | nil =>
      intro pre s eq hx hy
      rw [List.append_nil] at eq
      exact ⟨s, eq ▸ hx, eq ▸ hy⟩
    | cons g todo ih =>
      intro pre s eq hx hy
      let b (z : Fin 9 → Bool) :=
        g.op.eval (g.inputs.map fun i => (pre.foldl step (List.ofFn z)).getD i false)
      have same : b x = b y := by
        by_cases hr : v.val ∈ g.inputs
        · exact force pre g todo eq hr
        · unfold b
          rw [hx,hy]
          congr 1
          exact List.map_congr_left (fun i hi => agreeRaw a s i (fun h => hr (h ▸ hi)))
      apply ih (pre ++ [g]) (s ++ [b x]) (by simpa [List.append_assoc] using eq)
      · rw [List.foldl_append, List.foldl_cons, List.foldl_nil]
        change pre.foldl step (List.ofFn x) ++ [b x] = _
        rw [hx, List.append_assoc]
      · rw [List.foldl_append, List.foldl_cons, List.foldl_nil]
        change pre.foldl step (List.ofFn y) ++ [b y] = _
        rw [hy, List.append_assoc, same]
  exact aux C.gates [] [] (by simp) (by simp) (by simp)

theorem noDominatingReader (C : Circuit) (v u : Fin 9) (hv : v ∈ [4,6,7]) (ne : v ≠ u)
    (hr : ∀ (pre : List Gate) (g : Gate) (post : List Gate), C.gates = pre ++ g :: post →
      v.val ∈ g.inputs → g.op = .or ∧ ∃ i ∈ g.inputs, ∀ z : Fin 9 → Bool,
        z u = true → (pre.foldl step (List.ofFn z)).getD i false = true) :
    circuitFun 9 C ≠ edge := by
  intro correct
  have hout : C.output ≠ v.val := by
    intro out
    let z : Fin 9 → Bool := fun k => decide (k = v)
    have hz := congrFun correct z
    change (C.gates.foldl step (List.ofFn z)).getD C.output false = edge z at hz
    rw [out, earlier _ _ _ (by simp), singletonFalse v] at hz
    have hvread := raw z [] v
    simp only [List.append_nil] at hvread
    rw [hvread] at hz
    simp [z] at hz
  obtain ⟨t,offFalse,onTrue⟩ := witnesses v u hv ne
  let x := off u t
  let y := on v u t
  have a (j : Fin 9) (hj : j ≠ v) : x j = y j := by simp [x,y,off,on,hj]
  have forced (pre : List Gate) (g : Gate) (post : List Gate) (he : C.gates = pre ++ g :: post)
      (hrv : v.val ∈ g.inputs) :
      g.op.eval (g.inputs.map fun k => (pre.foldl step (List.ofFn x)).getD k false) =
      g.op.eval (g.inputs.map fun k => (pre.foldl step (List.ofFn y)).getD k false) := by
    obtain ⟨hop,i,hi,path⟩ := hr pre g post he hrv
    have active (z : Fin 9 → Bool) (hz : z u = true) :
        g.op.eval (g.inputs.map fun k => (pre.foldl step (List.ofFn z)).getD k false) = true := by
      rw [hop]
      simp only [GateOp.eval, List.any_map, List.any_eq_true]
      exact ⟨i,hi,path z hz⟩
    exact (active x (by simp [x,off])).trans (active y (by simp [y,on])).symm
  obtain ⟨s,hs,hs'⟩ := maskedAll C a forced
  have same : circuitFun 9 C x = circuitFun 9 C y := by
    change (C.gates.foldl step (List.ofFn x)).getD C.output false = (C.gates.foldl step (List.ofFn y)).getD C.output false
    rw [hs,hs']
    exact agreeRaw a s C.output hout
  rw [correct] at same
  change edge (off u t) = edge (on v u t) at same
  rw [offFalse,onTrue] at same
  contradiction
